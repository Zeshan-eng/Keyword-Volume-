# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Required -------------------------------------------------------------
# DataForSEO API credentials: https://app.dataforseo.com/api-access
# (API login + API password, not your website password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Access control ---------------------------------------------------------
# Comma-separated Chrome extension IDs allowed to call this API (chrome://extensions).
# Required when NODE_ENV=production. If empty in development, any extension origin is accepted.
ALLOWED_EXTENSION_IDS=

# --- Optional (defaults shown) ------------------------------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Use https://sandbox.dataforseo.com for DataForSEO's free sandbox (returns sample data).
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Cache lifetime for keyword+country results (seconds).
CACHE_TTL_SECONDS=86400
# A manual refresh only re-queries the provider if the cached entry is older than this.
REFRESH_MIN_AGE_SECONDS=3600
CACHE_MAX_ENTRIES=10000
# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=30
# DataForSEO allows max 12 Google Ads Live requests/minute per account.
ADS_LIVE_MAX_PER_MINUTE=12
PROVIDER_TIMEOUT_MS=20000
# Number of reverse-proxy hops to trust for client IPs (e.g. 1 behind a load balancer).
TRUST_PROXY_HOPS=0
